FROM --platform=$BUILDPLATFORM golang:1.25.8@sha256:3ac2864710f25e84381bf5d4272261c7ba73ada0339d62034df4de20dabb33ca AS builder
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -mod=readonly -trimpath -ldflags="-w -s" -o /out/server .

FROM --platform=$TARGETPLATFORM casbin/casdoor:4.7.0@sha256:9d015582847d40c1d013ee7f2d746cb835a3ad4d72c82e23980b2a269809e4c3
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
COPY --from=builder /out/server /server
